  "email": null,
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "token": "${PUSHPLUS_TOKEN}",
      "title": "Horizon #{date} 资讯",
      "content": "结果：#{result}\n\n入选内容：#{important_items}/#{all_items}\n\n完整日报：https://stagepayload-design.github.io/horizon-daily/#{date_path}/summary-zh.html\n\n#{summary?limit=3500&split=---}",
      "template": "markdown",
      "channel": "wechat"
    },
    "headers": "",
    "extra_targets": [
      {
        "url_env": "HORIZON_WEBHOOK_URL_DINGTALK",
        "request_body": {
          "msgtype": "markdown",
          "markdown": {
            "title": "Horizon #{date} 日报",
            "text": "Horizon 日报\n\n结果：#{result}\n\n入选内容：#{important_items}/#{all_items}\n\n完整日报：https://stagepayload-design.github.io/horizon-daily/#{date_path}/summary-zh.html\n\n#{summary?limit=3500&split=---}"
          }
        },
        "enabled": true
      }
    ]
